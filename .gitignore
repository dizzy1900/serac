# secrets
.env
.env.*
!.env.example
# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
# dvc
.dvc/cache/
.dvc/tmp/
.dvc/config.local
# data (DVC-tracked, never committed to git)
data/raw/*
data/interim/*
data/features/*
# The discriminator's window index and chunk-hash index are deliberately committed (1.5 MB
# and 0.2 MB of metadata, no samples). They are what lets `validate-discriminator` prove
# every leakage assertion on a fresh clone where the multi-gigabyte Zarr store is absent:
# without them the gate would report green while proving almost nothing.
!data/features/discriminator/
data/features/discriminator/*
!data/features/discriminator/windows.json
!data/features/discriminator/chunk_hashes.tsv
baselines/*
# The discriminator's trained artifacts are deliberately committed: they are small (a text
# lightgbm model, a two-number calibrator, a provenance record, and a 0.5 MB torch
# state dict), and committing them is what lets CI, `validate-discriminator` and the
# streaming detector run offline with no training step.
!baselines/discriminator/
!baselines/discriminator_deep/
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/features/.gitkeep
# reports produced by runs (validation stamps are regenerated)
reports/replay/
reports/validation/
reports/promotion/
reports/cube/
# os / editors
.DS_Store
.idea/
.vscode/
