# data (DVC-tracked, never committed to git)
data/raw/*
data/interim/*
data/features/*
baselines/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/features/.gitkeep
# reports produced by runs (validation stamps are regenerated)
reports/replay/
reports/validation/
reports/promotion/
reports/cube/
# os / editors
.DS_Store
.idea/
.vscode/
