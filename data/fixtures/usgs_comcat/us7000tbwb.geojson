/us7000tbwb/us/1787900310526/us7000tbwb_ciim.ps","sha256":"YC69zhpEXhflWmX4x8xOKRcVT+jt7qg5I2exf2nJIYo="},"event_data.xml":{"contentType":"application/xml","lastModified":1787900309000,"length":2834,"url":"https://earthquake.usgs.gov/product/dyfi/us7000tbwb/us/1787900310526/event_data.xml","sha256":"iRIMThtokzsaQ8MOh5K44P8oa4pOJvdTiG68gUnu8zc="},"us7000tbwb_ciim_geo.jpg":{"contentType":"image/jpeg","lastModified":1787900309000,"length":134571,"url":"https://earthquake.usgs.gov/product/dyfi/us7000tbwb/us/1787900310526/us7000tbwb_ciim_geo.jpg","sha256":"w7+OcwSSNXxW5qPYH8XiRVLc25bcCaevH9F2n0Hrh3c="},"dyfi_plot_numresp.json":{"contentType":"application/json","lastModified":1787900309000,"length":205,"url":"https://earthquake.usgs.gov/product/dyfi/us7000tbwb/us/1787900310526/dyfi_plot_numresp.json","sha256":"EiGMqrE/jh5huZcQrP5N4ml8hqk10Ja5PaCeb4Bq3Xc="},"us7000tbwb_ciim_geo_imap.html":{"contentType":"text/html","lastModified":1787900309000,"length":303,"url":"https://earthquake.usgs.gov/product/dyfi/us7000tbwb/us/1787900310526/us7000tbwb_ciim_geo_imap.html","sha256":"BIajuLDaMuNLMEIO7ctIxfG9YaUXgvtaiUR7JN9LbBk="},"us7000tbwb_ciim_imap.html":{"contentType":"text/html","lastModified":1787900309000,"length":225,"url":"https://earthquake.usgs.gov/product/dyfi/us7000tbwb/us/1787900310526/us7000tbwb_ciim_imap.html","sha256":"9su7YFGqfIBNRtS9Hd+7TC1csynFk2MkGCfJgRZHrr4="},"dyfi.kmz":{"contentType":"application/vnd.google-earth.kmz","lastModified":1787900309000,"length":1130,"url":"https://earthquake.usgs.gov/product/dyfi/us7000tbwb/us/1787900310526/dyfi.kmz","sha256":"rpygf93YIh70qHClQaov3/zcBfKyjlnK3yknax1M5+8="},"us7000tbwb_ciim_geo.ps":{"contentType":"application/postscript","lastModified":1787900309000,"length":201169,"url":"https://earthquake.usgs.gov/product/dyfi/us7000tbwb/us/1787900310526/us7000tbwb_ciim_geo.ps","sha256":"41uQx5541shl6nrIpN+Wrow2iNiMwwrPrK28BY5lrvo="}}}],"general-header":[{"indexid":28528647,"indexTime":1787873802324,"id":"urn:usgs-product:admin:general-header:us7000tbwb-1787759497649:1787873798379","type":"general-header","code":"us7000tbwb-1787759497649","source":"admin","updateTime":1787873798379,"status":"UPDATE","properties":{"eventsource":"us","eventsourcecode":"7000tbwb","pdl-client-version":"Version 3.5.4 2026-01-22","review-status":"Reviewed","senderemail":"jpursley@usgs.gov"},"preferredWeight":1,"contents":{"":{"contentType":"1","lastModified":1787873798000,"length":658,"bytes":"<p class=\"alert info\">This event was initially reported as a magnitude 4.4 earthquake. Additional analysis of long period seismic waves indicate that the seismic energy was instead generated by a glacial collapse and debris flow. The location of this event was estimated from satellite images. About three hours after this event, a \n\n<a href=\"https://earthquake.usgs.gov/earthquakes/eventpage/us7000tc90/executive\">\nsecond landslide event \n</a>\noccurred in the region.\n\nFor more information see the\n<a href=\"https://www.usgs.gov/programs/landslide-hazards/science/2026-nepal-debris-avalanche-and-flash-flood\">\nUSGS landslides special event page. \n</a>\n\n</p>\n","sha256":"v+VwmZYCvBTeU3QLCJO8ZA1pbCcbHVD2Zo4vmS1ZYSo="}}}],"general-text":[{"indexid":28524176,"indexTime":1787770578705,"id":"urn:usgs-product:admin:general-text:us7000tbwb-1787769919148:1787770573664","type":"general-text","code":"us7000tbwb-1787769919148","source":"admin","updateTime":1787770573664,"status":"UPDATE","properties":{"eventsource":"us","eventsourcecode":"7000tbwb","pdl-client-version":"Version 3.5.4 2026-01-22","review-status":"Reviewed","senderemail":"wbarnhart@usgs.gov"},"preferredWeight":1,"contents":{"":{"contentType":"1","lastModified":1787770573000,"length":657,"bytes":"<h2>Key Points (updated Aug 26, 18:44 UTC)</h2>\n<ul>\n  <li>A magnitude 5.2 seismic event occurred near the border between Nepal and China on Aug 26 at 8:37 AM local time (10:52 AM China Standard Time).</li>\n<li>The USGS determined that the seismic event was a glacial collapse and debris flow that caused subsequent catastrophic impacts downstream.</li>\n<li>This event was initially reported as a magnitude 4.4 earthquake. Additional analysis of nearby seismic stations, long period seismic waves, and satellite imagery led to the determination that the seismic event was instead a glacial collapse and debris flow, and that no earthquake had occurred.</li>","sha256":"SsQdNre5XfYz95c1fYXsmdIH64d233Q7P2uxgyyY0lQ="}}}],"origin":[{"indexid":28523722,"indexTime":1787759951443,"id":"urn:usgs-product:us:origin:us7000tbwb:1787759943040","type":"origin","code":"us7000tbwb","source":"us","updateTime":1787759943040,"status":"UPDATE","properties":{"depth":"0","error-ellipse-azimuth":"0","error-ellipse-intermediate":"0","error-ellipse-major":"0","error-ellipse-minor":"0","error-ellipse-plunge":"0","error-ellipse-rotation":"90","evaluation-status":"preliminary","event-type":"landslide","eventParametersPublicID":"quakeml:us.anss.org/eventparameters/7000tbwb/1787759945","eventsource":"us","eventsourcecode":"7000tbwb","eventtime":"2026-08-26T02:52:10.000Z","eventtime-error":"0.00","horizontal-error":"0","latitude":"28.2710","latitude-error":"0.0000","longitude":"85.5150","longitude-error":"0.0000","magnitude":"5.2","magnitude-error":"0.09","magnitude-num-stations-used":"26","magnitude-source":"us","magnitude-type":"ms_vx","num-phases-used":"0","num-stations-used":"0","origin-source":"us","pdl-client-version":"Version 3.5.4 2026-01-22","quakeml-magnitude-publicid":"quakeml:us.anss.org/magnitude/7000tbwb/ms_vx","quakeml-origin-publicid":"quakeml:us.anss.org/origin/locationdisp_20260826153622_28_86","quakeml-publicid":"quakeml:us.anss.org/event/7000tbwb","review-status":"reviewed","standard-error":"11.91","title":"55 km NW of Kodāri̇̄, Nepal","vertical-error":"0"},"preferredWeight":158,"contents":{"contents.xml":{"contentType":"application/xml","lastModified":1787759947000,"length":195,"url":"https://earthquake.usgs.gov/product/origin/us7000tbwb/us/17877599