# serac credentials and endpoints. Copy to .env (gitignored). See docs/CREDENTIALS.md.
# None of these are required for the offline test suite.

# NASA Earthdata Login: Sentinel-1 downloads via ASF, HyP3 InSAR jobs, NISAR products (free account)
# A bearer token from https://urs.earthdata.nasa.gov/profile is preferred over a password;
# asf_search and hyp3-sdk both accept one. Tokens expire, so record the expiry somewhere.
EARTHDATA_TOKEN=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Copernicus Data Space Ecosystem OAuth client credentials (Sentinel-2 L2A via CDSE)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Copernicus Climate Data Store (ERA5 via cdsapi)
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# GACOS tropospheric corrections are delivered by email after a web-form request
GACOS_EMAIL=

# Streaming
SERAC_REDIS_URL=redis://localhost:6379/0
SERAC_SEEDLINK_SERVER=geofon.gfz.de:18000

# CAP alerting (M5). Paths, not secrets. Generate with `serac alerting keygen`; the private
# key is written 0600 and `.gitignore` excludes '*.pem' and 'secrets/'. Never commit it.
SERAC_CAP_SIGNING_KEY=
SERAC_CAP_PUBLIC_KEY=
# Outbound CAP destination. There is NO default: the HTTP sink refuses to be constructed
# without an explicit endpoint, and still sends nothing unless `--send` is passed.
SERAC_ALERT_HTTP_ENDPOINT=

# Data versioning: remote URL is written to .dvc/config.local by `make dvc-remote`
DVC_REMOTE_URL=

# Set to 1 to allow network in `make smoke-online`
SERAC_ONLINE=0
