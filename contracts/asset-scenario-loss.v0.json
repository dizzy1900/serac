{
  "$defs": {
    "AttributedEstimate": {
      "additionalProperties": false,
      "description": "One published figure, attributed to exactly one source.",
      "properties": {
        "high": {
          "title": "High",
          "type": "number"
        },
        "low": {
          "title": "Low",
          "type": "number"
        },
        "qualifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. 'order of magnitude', 'preliminary', 'bed erosion only'",
          "title": "Qualifier"
        },
        "source_ref": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Source Ref",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "low",
        "high",
        "unit",
        "source_ref"
      ],
      "title": "AttributedEstimate",
      "type": "object"
    },
    "LossBlockedBy": {
      "description": "The specific missing input that stopped one asset from being costed.",
      "enum": [
        "no_transect",
        "no_arrival",
        "no_flow_depth",
        "no_replacement_value"
      ],
      "title": "LossBlockedBy",
      "type": "string"
    },
    "MoneyRange": {
      "additionalProperties": false,
      "description": "A monetary interval in a stated currency and price year.",
      "properties": {
        "basis": {
          "description": "How the figure was derived",
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "best": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Best"
        },
        "currency": {
          "description": "ISO 4217",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "high": {
          "minimum": 0,
          "title": "High",
          "type": "number"
        },
        "low": {
          "minimum": 0,
          "title": "Low",
          "type": "number"
        },
        "price_year": {
          "maximum": 2100,
          "minimum": 1900,
          "title": "Price Year",
          "type": "integer"
        }
      },
      "required": [
        "low",
        "high",
        "currency",
        "price_year",
        "basis"
      ],
      "title": "MoneyRange",
      "type": "object"
    },
    "Range": {
      "additionalProperties": false,
      "description": "A sourced numeric interval. Every number in an event record is one of these.\n\n`best` is optional and may only be set when the owning record can show a qualifying source\n(see `BEST_QUALIFYING_KINDS`); the aggregate enforces that because a `Range` cannot see the\n`sources[]` list on its own.",
      "properties": {
        "best": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Best"
        },
        "disputed": {
          "default": false,
          "title": "Disputed",
          "type": "boolean"
        },
        "estimates": {
          "items": {
            "$ref": "#/$defs/AttributedEstimate"
          },
          "title": "Estimates",
          "type": "array"
        },
        "high": {
          "title": "High",
          "type": "number"
        },
        "low": {
          "title": "Low",
          "type": "number"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "source_refs": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "low",
        "high",
        "unit",
        "source_refs"
      ],
      "title": "Range",
      "type": "object"
    }
  },
  "$id": "https://github.com/dizzy1900/serac/contracts/asset-scenario-loss.v0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One asset under one scenario: either costed, or explicitly blocked and why.\n\n`determined=False` says serac could not cost this asset. That is not a zero loss, and the\nvalidator refuses to let it carry one: an undetermined asset with a number attached is\nexactly how an unassessable exposure comes to look safe.",
  "properties": {
    "arrival_time_min": {
      "anyOf": [
        {
          "$ref": "#/$defs/Range"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "asset_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Asset Id",
      "type": "string"
    },
    "avoided_vs_baseline": {
      "anyOf": [
        {
          "$ref": "#/$defs/MoneyRange"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "blocked_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/LossBlockedBy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "blocked_detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Blocked Detail"
    },
    "determined": {
      "title": "Determined",
      "type": "boolean"
    },
    "expected_loss": {
      "anyOf": [
        {
          "$ref": "#/$defs/MoneyRange"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "flow_depth_m": {
      "anyOf": [
        {
          "$ref": "#/$defs/Range"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "lead_time_min": {
      "anyOf": [
        {
          "$ref": "#/$defs/Range"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "replacement_value": {
      "anyOf": [
        {
          "$ref": "#/$defs/MoneyRange"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "scenario_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Scenario Id",
      "type": "string"
    }
  },
  "required": [
    "asset_id",
    "scenario_id",
    "determined"
  ],
  "title": "AssetScenarioLoss",
  "type": "object"
}
