{
  "$defs": {
    "SourceKind": {
      "description": "What kind of document a `SourceRef` points at.",
      "enum": [
        "peer_reviewed",
        "preprint",
        "conference_abstract",
        "usgs_comcat",
        "agency_official",
        "dataset",
        "press_report"
      ],
      "title": "SourceKind",
      "type": "string"
    }
  },
  "$id": "https://github.com/dizzy1900/serac/contracts/source-ref.v0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A document that was actually retrieved, hashed and read in-session.\n\n`sha256` is the digest of the bytes that were retrieved (for a paywalled paper this is the\nlanding page, and `stored_copy` is None). `claims_supported` lists the dotted field paths\nof the record that this source backs.",
  "properties": {
    "accessed_utc": {
      "format": "date-time",
      "title": "Accessed Utc",
      "type": "string"
    },
    "authors": {
      "items": {
        "type": "string"
      },
      "title": "Authors",
      "type": "array"
    },
    "claims_supported": {
      "items": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\[\\d+\\]|\\.[A-Za-z0-9_-]+)*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Claims Supported",
      "type": "array"
    },
    "content_type": {
      "minLength": 1,
      "title": "Content Type",
      "type": "string"
    },
    "doi": {
      "anyOf": [
        {
          "pattern": "^10\\.\\d{4,9}/\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Doi"
    },
    "excerpt": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Excerpt"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/SourceKind"
    },
    "licence": {
      "description": "SPDX id or the licence as stated",
      "minLength": 1,
      "title": "Licence",
      "type": "string"
    },
    "peer_reviewed": {
      "title": "Peer Reviewed",
      "type": "boolean"
    },
    "publisher": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Publisher"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "stored_copy": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Repo-relative path of a stored copy, if the licence allows",
      "title": "Stored Copy"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "url": {
      "pattern": "^https?://\\S+$",
      "title": "Url",
      "type": "string"
    },
    "year": {
      "anyOf": [
        {
          "maximum": 2100,
          "minimum": 1800,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Year"
    }
  },
  "required": [
    "id",
    "kind",
    "title",
    "url",
    "accessed_utc",
    "sha256",
    "content_type",
    "licence",
    "claims_supported",
    "peer_reviewed"
  ],
  "title": "SourceRef",
  "type": "object"
}
