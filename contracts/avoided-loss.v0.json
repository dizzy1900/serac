{
  "$defs": {
    "AssetType": {
      "enum": [
        "hydropower_plant",
        "bridge",
        "settlement",
        "border_post",
        "road",
        "other"
      ],
      "title": "AssetType",
      "type": "string"
    },
    "AttributedEstimate": {
      "additionalProperties": false,
      "description": "One published figure, attributed to exactly one source.",
      "properties": {
        "high": {
          "title": "High",
          "type": "number"
        },
        "low": {
          "title": "Low",
          "type": "number"
        },
        "qualifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "e.g. 'order of magnitude', 'preliminary', 'bed erosion only'",
          "title": "Qualifier"
        },
        "source_ref": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Source Ref",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "low",
        "high",
        "unit",
        "source_ref"
      ],
      "title": "AttributedEstimate",
      "type": "object"
    },
    "CascadeForecast": {
      "additionalProperties": false,
      "description": "The L3 output for one detection: footprint, arrivals per transect, damming.",
      "properties": {
        "aoi_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Aoi Id",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "confidence_tier": {
          "$ref": "#/$defs/ConfidenceTier"
        },
        "contract_version": {
          "default": "0.2.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Contract Version",
          "type": "string"
        },
        "damming": {
          "anyOf": [
            {
              "$ref": "#/$defs/DammingEstimate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "detection_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detection Id"
        },
        "event_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set when replaying a known event",
          "title": "Event Id"
        },
        "footprint": {
          "anyOf": [
            {
              "$ref": "#/$defs/Polygon"
            },
            {
              "$ref": "#/$defs/MultiPolygon"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Footprint"
        },
        "forecast_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Forecast Id",
          "type": "string"
        },
        "issued_utc": {
          "format": "date-time",
          "title": "Issued Utc",
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/ForecastModel"
        },
        "origin_time_utc": {
          "format": "date-time",
          "title": "Origin Time Utc",
          "type": "string"
        },
        "runout_km": {
          "$ref": "#/$defs/Range"
        },
        "source_location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Point"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_volume_m3": {
          "$ref": "#/$defs/Range"
        },
        "transect_arrivals": {
          "items": {
            "$ref": "#/$defs/TransectArrival"
          },
          "title": "Transect Arrivals",
          "type": "array"
        }
      },
      "required": [
        "forecast_id",
        "aoi_id",
        "issued_utc",
        "origin_time_utc",
        "source_volume_m3",
        "runout_km",
        "model",
        "confidence_tier"
      ],
      "title": "CascadeForecast",
      "type": "object"
    },
    "ConfidenceTier": {
      "description": "Qualitative confidence; `unqualified` is the only tier a stub may claim.",
      "enum": [
        "unqualified",
        "low",
        "medium",
        "high"
      ],
      "title": "ConfidenceTier",
      "type": "string"
    },
    "DammingEstimate": {
      "additionalProperties": false,
      "description": "Whether, where and how large a landslide dam / barrier lake may form.",
      "properties": {
        "breach_time_after_formation_min": {
          "anyOf": [
            {
              "$ref": "#/$defs/Range"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dam_height_m": {
          "anyOf": [
            {
              "$ref": "#/$defs/Range"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dam_location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Point"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lake_volume_m3": {
          "anyOf": [
            {
              "$ref": "#/$defs/Range"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "probability": {
          "$ref": "#/$defs/Range"
        },
        "secondary_surges": {
          "items": {
            "$ref": "#/$defs/SecondarySurge"
          },
          "title": "Secondary Surges",
          "type": "array"
        }
      },
      "required": [
        "probability"
      ],
      "title": "DammingEstimate",
      "type": "object"
    },
    "ExposureItem": {
      "additionalProperties": false,
      "description": "One exposed asset as seen by the loss layer.",
      "properties": {
        "asset_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Asset Id",
          "type": "string"
        },
        "asset_type": {
          "$ref": "#/$defs/AssetType"
        },
        "population": {
          "anyOf": [
            {
              "$ref": "#/$defs/Range"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "replacement_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/MoneyRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "transect_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transect Id"
        }
      },
      "required": [
        "asset_id",
        "asset_type"
      ],
      "title": "ExposureItem",
      "type": "object"
    },
    "ForecastModel": {
      "additionalProperties": false,
      "description": "Identity of the model that produced a forecast.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/ModelProvenance"
        },
        "run_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "provenance"
      ],
      "title": "ForecastModel",
      "type": "object"
    },
    "InterventionKind": {
      "enum": [
        "none",
        "warning",
        "evacuation",
        "combined"
      ],
      "title": "InterventionKind",
      "type": "string"
    },
    "ModelProvenance": {
      "description": "What produced the numbers.",
      "enum": [
        "stub",
        "surrogate",
        "simulator"
      ],
      "title": "ModelProvenance",
      "type": "string"
    },
    "MoneyRange": {
      "additionalProperties": false,
      "description": "A monetary interval in a stated currency and price year.",
      "properties": {
        "basis": {
          "description": "How the figure was derived",
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "best": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Best"
        },
        "currency": {
          "description": "ISO 4217",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "high": {
          "minimum": 0,
          "title": "High",
          "type": "number"
        },
        "low": {
          "minimum": 0,
          "title": "Low",
          "type": "number"
        },
        "price_year": {
          "maximum": 2100,
          "minimum": 1900,
          "title": "Price Year",
          "type": "integer"
        }
      },
      "required": [
        "low",
        "high",
        "currency",
        "price_year",
        "basis"
      ],
      "title": "MoneyRange",
      "type": "object"
    },
    "MultiPolygon": {
      "additionalProperties": false,
      "description": "GeoJSON MultiPolygon.",
      "properties": {
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "anyOf": [
                  {
                    "maxItems": 2,
                    "minItems": 2,
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "type": "array"
                  },
                  {
                    "maxItems": 3,
                    "minItems": 3,
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "number"
                      }
                    ],
                    "type": "array"
                  }
                ]
              },
              "type": "array"
            },
            "type": "array"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        },
        "type": {
          "const": "MultiPolygon",
          "default": "MultiPolygon",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "MultiPolygon",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "description": "GeoJSON Point.",
      "properties": {
        "coordinates": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            }
          ],
          "title": "Coordinates"
        },
        "type": {
          "const": "Point",
          "default": "Point",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "Point",
      "type": "object"
    },
    "Polygon": {
      "additionalProperties": false,
      "description": "GeoJSON Polygon: one exterior ring followed by any number of holes.",
      "properties": {
        "coordinates": {
          "items": {
            "items": {
              "anyOf": [
                {
                  "maxItems": 2,
                  "minItems": 2,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                },
                {
                  "maxItems": 3,
                  "minItems": 3,
                  "prefixItems": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "type": "array"
                }
              ]
            },
            "type": "array"
          },
          "minItems": 1,
          "title": "Coordinates",
          "type": "array"
        },
        "type": {
          "const": "Polygon",
          "default": "Polygon",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "Polygon",
      "type": "object"
    },
    "Range": {
      "additionalProperties": false,
      "description": "A sourced numeric interval. Every number in an event record is one of these.\n\n`best` is optional and may only be set when the owning record can show a qualifying source\n(see `BEST_QUALIFYING_KINDS`); the aggregate enforces that because a `Range` cannot see the\n`sources[]` list on its own.",
      "properties": {
        "best": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Best"
        },
        "disputed": {
          "default": false,
          "title": "Disputed",
          "type": "boolean"
        },
        "estimates": {
          "items": {
            "$ref": "#/$defs/AttributedEstimate"
          },
          "title": "Estimates",
          "type": "array"
        },
        "high": {
          "title": "High",
          "type": "number"
        },
        "low": {
          "title": "Low",
          "type": "number"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "source_refs": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "low",
        "high",
        "unit",
        "source_refs"
      ],
      "title": "Range",
      "type": "object"
    },
    "SecondarySurge": {
      "additionalProperties": false,
      "description": "A surge released by a landslide-dam breach, arriving after the primary flow.\n\nCascade rules v0: the breach model is parametric, so `label` must name the rule set that\nproduced the estimate and every number is a `Range`.",
      "properties": {
        "arrival_after_breach_min": {
          "$ref": "#/$defs/Range"
        },
        "label": {
          "description": "e.g. 'cascade rules v0'",
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "origin_chainage_km": {
          "minimum": 0,
          "title": "Origin Chainage Km",
          "type": "number"
        },
        "peak_discharge_m3s": {
          "anyOf": [
            {
              "$ref": "#/$defs/Range"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "transect_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Transect Id",
          "type": "string"
        }
      },
      "required": [
        "origin_chainage_km",
        "transect_id",
        "arrival_after_breach_min",
        "label"
      ],
      "title": "SecondarySurge",
      "type": "object"
    },
    "TransectArrival": {
      "additionalProperties": false,
      "description": "Forecast arrival at one transect. Times are minutes after `origin_time_utc`.",
      "properties": {
        "arrival_time_min": {
          "$ref": "#/$defs/Range"
        },
        "lead_time_min": {
          "anyOf": [
            {
              "$ref": "#/$defs/Range"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minutes between the first alert and arrival"
        },
        "peak_discharge_m3s": {
          "anyOf": [
            {
              "$ref": "#/$defs/Range"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "peak_stage_m": {
          "anyOf": [
            {
              "$ref": "#/$defs/Range"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "transect_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Transect Id",
          "type": "string"
        }
      },
      "required": [
        "transect_id",
        "arrival_time_min"
      ],
      "title": "TransectArrival",
      "type": "object"
    },
    "WarningScenario": {
      "additionalProperties": false,
      "description": "One counterfactual: what warning or intervention is assumed.",
      "properties": {
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "intervention": {
          "$ref": "#/$defs/InterventionKind"
        },
        "lead_time_min": {
          "anyOf": [
            {
              "$ref": "#/$defs/Range"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Warning lead time; must be absent for the 'none' baseline"
        },
        "scenario_id": {
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
          "title": "Scenario Id",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "intervention",
        "description"
      ],
      "title": "WarningScenario",
      "type": "object"
    }
  },
  "$id": "https://github.com/dizzy1900/serac/contracts/avoided-loss.v0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Hazard footprint + arrival lead time per transect + exposure -> request for expected loss.",
  "properties": {
    "contract_version": {
      "const": "0.0.0",
      "default": "0.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "exposure": {
      "items": {
        "$ref": "#/$defs/ExposureItem"
      },
      "minItems": 1,
      "title": "Exposure",
      "type": "array"
    },
    "forecast": {
      "$ref": "#/$defs/CascadeForecast"
    },
    "request_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "title": "Request Id",
      "type": "string"
    },
    "requested_utc": {
      "format": "date-time",
      "title": "Requested Utc",
      "type": "string"
    },
    "requester": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requester"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/WarningScenario"
      },
      "minItems": 1,
      "title": "Scenarios",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "requested_utc",
    "forecast",
    "exposure",
    "scenarios"
  ],
  "title": "AvoidedLossRequest",
  "type": "object"
}
